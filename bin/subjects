#!/bin/bash
# Writes the subject tree of one book: its table of contents, read from the headings of the book's
# markdown files, before any of the text is read (FrameOntology_261021_oo01).
#
#   subjects <book-dir> <name>  > subjects/<name>.lisp
#
# A heading is a node when it carries a number ("3.1.", "3.3.2.") or names a chapter
# ("Chapter 3 ▪ ..."); the number gives the node's place in the tree. Headings without one
# (listings, API boxes, OCR misreadings) are not nodes. Each node says the file it starts in.
set -euo pipefail
BOOK=$(realpath "$1")
NAME=$2
echo "(in-package :rst)"
echo "(defsubjects $NAME :book \"$BOOK\")"
find "$BOOK" -name '*.md' -print0 | sort -zV | while IFS= read -r -d '' f; do
    rel=${f#"$BOOK"/}
    awk -v file="$rel" '
        /^#+ / {
            h = $0
            sub(/^#+ +/, "", h); gsub(/[*_]/, "", h); gsub(/[ \t]+$/, "", h)
            num = ""; title = ""
            if (match(h, /^Chapter [0-9]+/)) {
                num = substr(h, 9, RLENGTH - 8); title = substr(h, RLENGTH + 1)
                sub(/^[ \t]*[^A-Za-z0-9]*[ \t]*/, "", title)
            } else if (match(h, /^[0-9]+(\.[0-9]+)+\.? /)) {
                num = substr(h, 1, RLENGTH - 1); sub(/\.$/, "", num); title = substr(h, RLENGTH + 1)
            }
            if (num == "") next
            gsub(/\\/, "\\\\", title); gsub(/"/, "\\\"", title)
            gsub(/\\/, "\\\\", file)
            printf "(subject \"%s\" \"%s\" :file \"%s\")\n", num, title, file
        }' "$f"
done

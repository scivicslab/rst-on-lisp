;;; subject: opendev-terminal-agent-2603 2.2.3 Conversation Lifecycle: the path of one user message from the entry points through the loop to persistence, with the hooks and the mechanisms that work across it
;;; made-from: doc_Base012/docs/Papers-AgentHarness/opendev-terminal-agent/02_agent-core/02_agent-core.lisp / p-lifecycle-trace p-input-entry-paths p-iteration-sequence p-termination-and-save p-lifecycle-hooks p-cross-cutting-intro p-interrupt-tokens p-injection-queue p-cost-tracking
;;; members: entry-paths iteration termination hooks cross-cutting
;;; children (:include / :frame, in the text's order): iteration-steps (each item one copy of opendev.agent-core.iteration-step.lisp), mechanisms (each item one copy of opendev.agent-core.mechanism.lisp)
;;; elsewhere: none
;;; left-out: the caption of Figure 6
(defrule lifecycle -> lifecycle-entry-paths lifecycle-iteration iteration-steps lifecycle-termination lifecycle-hooks lifecycle-cross-cutting mechanisms)
(defrule lifecycle-entry-paths -> :nucleus lifecycle-entry-paths/paths :elaboration-set-member lifecycle-entry-paths/preprocessing)
(defrule lifecycle-entry-paths/paths -> :instruction "入力が入る経路の数と種類を 1 文で書く" :sample "User input arrives through one of three entry paths: a non-interactive CLI invocation that creates a one-shot session, the TUI that wraps an interactive REPL, or the Web UI that accepts messages over WebSocket.")
(defrule lifecycle-entry-paths/preprocessing -> :instruction "経路によって前処理があるかを 1 文で書く" :sample "The TUI path applies a pre-processing stage before entering the ReAct loop: persisting the message to the session store, firing lifecycle hooks that can inspect or modify the query, expanding inline file references (e.g., @file) into their contents, and assembling the message list in the format expected by the LLM API.")
(defrule lifecycle-iteration -> :instruction "繰り返し 1 回の手順が決まっていることを 1 文で書く" :sample "Each iteration of the ReAct loop follows a fixed sequence.")
(defrule iteration-steps -> :instruction "繰り返しの手順を、行う順に、1 行に 1 つ手順の名前で挙げる" :frame "opendev.agent-core.iteration-step.lisp")
(defrule lifecycle-termination -> :nucleus lifecycle-termination/paths :elaboration-process-step lifecycle-termination/check)
(defrule lifecycle-termination/paths -> :instruction "ループが終わる経路を数と種類で 1 文で書く" :sample "The loop terminates through one of four paths: the agent responds with text and no tool calls (implicit completion), the agent explicitly signals done via a completion tool, the error-recovery budget is exhausted (the system injects up to three targeted recovery messages per error sequence (Section 2.3.5)), or the iteration count reaches the safety limit.")
(defrule lifecycle-termination/check -> :instruction "終わりを受け入れる前の確認と、受け入れた後の保存を 1 文で書く" :sample "Before accepting termination, the system checks for incomplete task items and pending messages in the injection queue (a thread-safe channel through which the UI can deliver messages mid-execution), deferring completion if either condition holds.")
(defrule lifecycle-hooks -> :nucleus lifecycle-hooks/events :elaboration-set-member lifecycle-hooks/blocking :elaboration-object-attribute lifecycle-hooks/merging)
(defrule lifecycle-hooks/events -> :instruction "外部の手続きが観察、介入できる出来事を挙げて 1 文で書く" :sample "OpenDev exposes lifecycle events that external scripts can observe or intercept: SessionStart, UserPromptSubmit, PreToolUse, PostToolUse, PostToolUseFailure, SubagentStart, SubagentStop, Stop, PreCompact, and SessionEnd.")
(defrule lifecycle-hooks/blocking -> :instruction "止められる出来事と、止めない出来事の違いを 1 文で書く" :sample "Blocking events (PreToolUse, UserPromptSubmit, SubagentStart) can prevent the operation (exit code 2 returns a block reason to the agent), mutate tool arguments (stdout JSON with tool_input key), or override approval decisions.")
(defrule lifecycle-hooks/merging -> :instruction "全体の設定と案件の設定のフックをどう合わせるかを 1 文で書く" :sample "Global and project hooks merge by appending project matchers after global matchers per event type, enabling organization-wide policies combined with repository-specific hooks (e.g., “run eslint after file edits”).")
(defrule lifecycle-cross-cutting -> :instruction "全段階にまたがる仕組みの数を 1 文で書く" :sample "Three mechanisms operate across all phases of the lifecycle.")
(defrule mechanisms -> :instruction "全段階にまたがる仕組みを、1 行に 1 つ仕組みの名前で挙げる" :frame "opendev.agent-core.mechanism.lisp")

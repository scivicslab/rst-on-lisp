;;; subject: opendev-terminal-agent-2603 2.2.3 Conversation Lifecycle: the path of one user message from the entry points through the loop to persistence, with the hooks and the mechanisms that work across it
;;; made-from: doc_Base012/docs/Papers-AgentHarness/opendev-terminal-agent/02_agent-core/02_agent-core.lisp / s23 .. s28
;;; members: trace ingestion iteration completion hooks cross-cutting
;;; elsewhere: none
;;; left-out: the caption of Figure 6
(defrule lifecycle -> lifecycle-trace lifecycle-ingestion lifecycle-iteration lifecycle-completion lifecycle-hooks lifecycle-cross-cutting)
(defrule lifecycle-trace -> :nucleus lifecycle-trace/n)
(defrule lifecycle-trace/n -> :instruction "1 件のメッセージの道筋を図でたどると書く" :sample "Figure 6 traces the end-to-end path of a single user message through the system, from initial input to final session persistence.")
(defrule lifecycle-ingestion -> :nucleus lifecycle-ingestion/n :elaboration-additional lifecycle-ingestion/a1 :elaboration-additional lifecycle-ingestion/a2)
(defrule lifecycle-ingestion/n -> :instruction "入力が入る三つの経路を 1 文で書く" :sample "User input arrives through one of three entry paths: a non-interactive CLI invocation that creates a one-shot session, the TUI that wraps an interactive REPL, or the Web UI that accepts messages over WebSocket.")
(defrule lifecycle-ingestion/a1 -> :instruction "前処理を行う経路と、その中身を 1 文で書く" :sample "The TUI path applies a pre-processing stage before entering the ReAct loop: persisting the message to the session store, firing lifecycle hooks that can inspect or modify the query, expanding inline file references (e.g., @file) into their contents, and assembling the message list in the format expected by the LLM API.")
(defrule lifecycle-ingestion/a2 -> :instruction "前処理を行わない経路を 1 文で書く" :sample "The Web and CLI paths invoke the agent directly without pre-processing.")
(defrule lifecycle-iteration -> :nucleus lifecycle-iteration/n :elaboration-process-step lifecycle-iteration/a1 :elaboration-process-step lifecycle-iteration/a2 :elaboration-process-step lifecycle-iteration/a3 :elaboration-process-step lifecycle-iteration/a4)
(defrule lifecycle-iteration/n -> :instruction "ループの 1 回の繰り返しが決まった順序をたどることを 1 文で書く" :sample "Each iteration of the ReAct loop follows a fixed sequence.")
(defrule lifecycle-iteration/a1 -> :instruction "最初に何を取り出すかを 1 文で書く" :sample "First, the executor drains any messages that the UI thread injected since the last iteration, such as follow-up instructions or system signals delivered through a thread-safe queue.")
(defrule lifecycle-iteration/a2 -> :instruction "次に何を点検するかを 1 文で書く" :sample "Second, the context compactor checks token utilization against the context window and applies reduction strategies if pressure is rising (Section 2.3.6 describes the compaction mechanism).")
(defrule lifecycle-iteration/a3 -> :instruction "3 番目の段階を 1 文で書く" :sample "Third, if thinking mode is enabled, a separate LLM call produces a reasoning trace without tool access, preventing premature action.")
(defrule lifecycle-iteration/a4 -> :instruction "4 番目の段階と、道具の呼び出しの並べ方を 1 文で書く" :sample "Fourth, the action model receives the full conversation, including any thinking trace, along with the available tool schemas, and returns a response that may contain text, tool calls, or both.")
(defrule lifecycle-completion -> :nucleus lifecycle-completion/n :elaboration-additional lifecycle-completion/a1)
(defrule lifecycle-completion/n -> :instruction "ループが終わる経路の数と、その内容を 1 文で書く" :sample "The loop terminates through one of four paths: the agent responds with text and no tool calls (implicit completion), the agent explicitly signals done via a completion tool, the error-recovery budget is exhausted (the system injects up to three targeted recovery messages per error sequence (Section 2.3.5)), or the iteration count reaches the safety limit.")
(defrule lifecycle-completion/a1 -> :instruction "終了を受け入れる前に確かめることと、受け入れた後に保存することを 1 文で書く" :sample "Before accepting termination, the system checks for incomplete task items and pending messages in the injection queue (a thread-safe channel through which the UI can deliver messages mid-execution), deferring completion if either condition holds.")
(defrule lifecycle-hooks -> :nucleus lifecycle-hooks/n :elaboration-additional lifecycle-hooks/a1 :elaboration-additional lifecycle-hooks/a2 :elaboration-additional lifecycle-hooks/a3 :elaboration-additional lifecycle-hooks/a4)
(defrule lifecycle-hooks/n -> :instruction "外部の手続きが観察、介入できる出来事を挙げて 1 文で書く" :sample "OpenDev exposes lifecycle events that external scripts can observe or intercept: SessionStart, UserPromptSubmit, PreToolUse, PostToolUse, PostToolUseFailure, SubagentStart, SubagentStop, Stop, PreCompact, and SessionEnd.")
(defrule lifecycle-hooks/a1 -> :instruction "フックの設定の仕方と受け取る情報を 1 文で書く" :sample "Hook commands are configured via JSON in global or project settings and receive event context on stdin as JSON.")
(defrule lifecycle-hooks/a2 -> :instruction "止められる出来事ができることを 1 文で書く" :sample "Blocking events (PreToolUse, UserPromptSubmit, SubagentStart) can prevent the operation (exit code 2 returns a block reason to the agent), mutate tool arguments (stdout JSON with tool_input key), or override approval decisions.")
(defrule lifecycle-hooks/a3 -> :instruction "止めない出来事の扱いを 1 文で書く" :sample "Non-blocking events fire asynchronously after the operation completes.")
(defrule lifecycle-hooks/a4 -> :instruction "全体と案件のフックの合わせ方と、その効果を 1 文で書く" :sample "Global and project hooks merge by appending project matchers after global matchers per event type, enabling organization-wide policies combined with repository-specific hooks (e.g., “run eslint after file edits”).")
(defrule lifecycle-cross-cutting -> :nucleus lifecycle-cross-cutting/n :elaboration-set-member lifecycle-cross-cutting/a1 :elaboration-set-member lifecycle-cross-cutting/a2 :elaboration-set-member lifecycle-cross-cutting/a3)
(defrule lifecycle-cross-cutting/n -> :instruction "全段階にまたがる仕組みの数を 1 文で書く" :sample "Three mechanisms operate across all phases of the lifecycle.")
(defrule lifecycle-cross-cutting/a1 -> :instruction "中断の仕組みを 1 文で書く" :sample "Interrupt tokens propagate cancellation requests from the UI to the agent thread, polled at six phase boundaries within each iteration (before and after thinking, before action, during tool execution, and at iteration boundaries).")
(defrule lifecycle-cross-cutting/a2 -> :instruction "割り込みの待ち行列を 1 文で書く" :sample "A thread-safe injection queue allows users to send follow-up messages while the agent is mid-execution; these messages are drained at iteration boundaries and checked before completion, ensuring that no user input is silently dropped.")
(defrule lifecycle-cross-cutting/a3 -> :instruction "費用の記録を 1 文で書く" :sample "Session cost tracking records cumulative token usage and cost after each LLM call via a CostTracker service that computes cost from the API’s reported token counts and the model’s pricing metadata; running totals are displayed in the TUI status bar and persisted in session metadata for resumption across --continue invocations.")

;;; subject: opendev-terminal-agent-2603 2.4.1 Registry Architecture and Schema Construction: how tools are grouped into handler categories behind one registry, how their schemas are built, and how approval rules and lifecycle hooks gate each call
;;; made-from: doc_Base012/docs/Papers-AgentHarness/opendev-terminal-agent/04_tool-system/04_tool-system.lisp / s2 .. s5
;;; members: need concerns schema-builder registry-dispatch hooks design-evolution approval approval-store
;;; elsewhere: the approval rules paragraphs belong, in a tree of the whole harness, to permissions; here they stay members because the paper explains them inside this node
;;; left-out: the caption of Figure 16
(defrule registry -> registry-need registry-concerns registry-schema-builder registry-registry-dispatch registry-hooks registry-design-evolution registry-approval registry-approval-store)
(defrule registry-need -> :nucleus registry-need/n :elaboration-additional registry-need/a1 :elaboration-additional registry-need/a2)
(defrule registry-need/n -> :instruction "道具を平らな名前空間に置くと管理できなくなる問題を 1 文で書く" :sample "A flat namespace of tools becomes unmanageable as capabilities grow: hard-coded dispatch logic is inflexible, and dynamic plugin loading without structure is unsafe.")
(defrule registry-need/a1 -> :instruction "両極端の選択肢を 1 文で書く" :sample "Alternatives range from hardcoded tool sets (simple but cannot add capabilities without code changes) to flat dynamic loading (flexible but chaotic, leading to namespace collisions, lack of organization, and difficult safety management).")
(defrule registry-need/a2 -> :instruction "採った方式を 1 文で書く" :sample "OpenDev adopts a registry with handler categories, organizing tools into handler classes with schema-based registration.")
(defrule registry-concerns -> :nucleus registry-concerns/n)
(defrule registry-concerns/n -> :instruction "道具の仕組みを分ける三つの関心を 1 文で書く" :sample "Figure 16 illustrates the architecture.")
(defrule registry-schema-builder -> :nucleus registry-schema-builder/n :elaboration-additional registry-schema-builder/a1)
(defrule registry-schema-builder/n -> :instruction "定義の組み立て役が集める出どころを 1 文で書く" :sample "ToolSchemaBuilder assembles JSON schemas from three sources: (1) static _BUILTIN_TOOL_SCHEMAS defining approximately 40 built-in tools, with descriptions loaded from markdown templates via load_tool_description(); (2) dynamically discovered MCP schemas, including only those tools in the _discovered_mcp_tools set to avoid context bloat; and (3) subagent schemas injected by the SubAgentManager when present.")
(defrule registry-schema-builder/a1 -> :instruction "組み立てた定義の渡し先と効果を 1 文で書く" :sample "The assembled schemas are injected into the LLM prompt, giving the model awareness of available capabilities.")
(defrule registry-registry-dispatch -> :nucleus registry-registry-dispatch/n :elaboration-additional registry-registry-dispatch/a1 :elaboration-additional registry-registry-dispatch/a2)
(defrule registry-registry-dispatch/n -> :instruction "登録簿が呼び出しを配る仕組みを 1 文で書く" :sample "ToolRegistry serves as the central dispatcher, mapping tool names to handler methods across 12 handler classes organized by category (file, process, web, notebook, user interaction, task management, thinking, MCP discovery, batch execution; see Table 1 in Appendix A for the complete mapping).")
(defrule registry-registry-dispatch/a1 -> :instruction "各取り扱い部品が受け取る共通の部品を 1 文で書く" :sample "Each handler receives a ToolExecutionContext that bundles cross-cutting services: mode manager, approval manager, undo manager, task monitor, session manager, UI callback, and file-time tracker.")
(defrule registry-registry-dispatch/a2 -> :instruction "計画モードでの書き込みの扱いを 1 文で書く" :sample "The registry enforces mode restrictions by blocking write operations in plan mode with informative errors before dispatching to handlers.")
(defrule registry-hooks -> :nucleus registry-hooks/n :elaboration-additional registry-hooks/a1 :elaboration-additional registry-hooks/a2 :elaboration-additional registry-hooks/a3 :elaboration-additional registry-hooks/a4 :elaboration-additional registry-hooks/a5 :elaboration-additional registry-hooks/a6)
(defrule registry-hooks/n -> :instruction "フックが取り扱い部品を変えずに拡張を可能にすることを 1 文で書く" :sample "Lifecycle hooks provide extensibility without modifying handler code.")
(defrule registry-hooks/a1 -> :instruction "フックが扱う出来事の範囲を 1 文で書く" :sample "The hook system defines ten lifecycle events (SESSION_START, USER_PROMPT_SUBMIT, PRE_TOOL_USE, POST_TOOL_USE, POST_TOOL_USE_FAILURE, SUBAGENT_START, SUBAGENT_STOP, PRE_COMPACT, SESSION_END, and STOP) covering the full agent lifecycle from session initialization to shutdown.")
(defrule registry-hooks/a2 -> :instruction "実行前フックが止められることを 1 文で書く" :sample "PreToolUse hooks fire synchronously before execution: a hook returning exit code 2 hard-blocks the tool call, returning an error to the model that no amount of prompt engineering or approval configuration can override.")
(defrule registry-hooks/a3 -> :instruction "引数の書き換えができることを 1 文で書く" :sample "Hooks can also mutate tool arguments by returning a JSON object with an updatedInput field, enabling transparent command rewriting (e.g., injecting --dry-run flags).")
(defrule registry-hooks/a4 -> :instruction "実行後フックの扱いを 1 文で書く" :sample "PostToolUse and PostToolUseFailure hooks fire asynchronously via a thread pool after execution, suitable for auditing and logging without delaying the agent.")
(defrule registry-hooks/a5 -> :instruction "外部の手続きが受け取る情報と使い道を 1 文で書く" :sample "External scripts registered as hooks receive full event context as JSON on stdin (including session ID, working directory, tool name, tool input, and (for post-hooks) tool response), enabling project-specific policies such as blocking writes to protected paths, enforcing naming conventions, or streaming audit logs to external systems.")
(defrule registry-hooks/a6 -> :instruction "対象の絞り方を 1 文で書く" :sample "Hook matchers use compiled regex patterns against tool names, allowing fine-grained targeting from single-tool rules to catch-all policies.")
(defrule registry-design-evolution -> :nucleus registry-design-evolution/n :elaboration-additional registry-design-evolution/a1)
(defrule registry-design-evolution/n -> :instruction "初期の版の登録の仕方と、その問題を 1 文で書く" :sample "Early versions registered tools directly in a global namespace, causing naming collisions and complex per-tool safety configuration.")
(defrule registry-design-evolution/a1 -> :instruction "分類ごとの取り扱い部品がその問題を解いたことを 1 文で書く" :sample "Category-based handlers solved both: safety rules apply at the category level, and each category provides implicit namespacing.")
(defrule registry-approval -> :nucleus registry-approval/n :elaboration-additional registry-approval/a1 :elaboration-additional registry-approval/a2 :elaboration-additional registry-approval/a3 :elaboration-additional registry-approval/a4)
(defrule registry-approval/n -> :instruction "道具の呼び出しが取り扱い部品に届く前に、承認の仕組みが門を置くことを 1 文で書く" :sample "Before any tool call reaches its handler, the runtime approval system gates execution based on user-configured trust boundaries.")
(defrule registry-approval/a1 -> :instruction "既定の三つの自律の水準を 1 文で書く" :sample "Three autonomy levels control the default posture: Manual requires explicit approval for every tool call; Semi-Auto auto-approves read-only operations (a curated allowlist of commands such as ls, cat, git status) while prompting for writes; and Auto approves all operations for trusted workflows.")
(defrule registry-approval/a2 -> :instruction "水準の上に置く規則の管理部品と、規則の種類を 1 文で書く" :sample "Beyond the default level, an ApprovalRulesManager evaluates each command against a prioritized rule set with four rule types: Pattern (regex match against the full command string), Command (exact match), Prefix (prefix match, e.g., git matching git push), and Danger (regex match with auto-deny semantics).")
(defrule registry-approval/a3 -> :instruction "消せない危険の規則を 1 文で書く" :sample "Default danger rules at priority 100 (matching patterns such as rm -rf /, rm -rf *, and chmod 777) are always active and cannot be overridden by user configuration or approval-level changes.")
(defrule registry-approval/a4 -> :instruction "規則の評価の順序を 1 文で書く" :sample "Rules are evaluated in priority order; the first match determines the action (auto-approve, auto-deny, require approval, or require the user to edit the command before execution).")
(defrule registry-approval-store -> :nucleus registry-approval-store/n :elaboration-additional registry-approval-store/a1 :elaboration-additional registry-approval-store/a2 :elaboration-additional registry-approval-store/a3)
(defrule registry-approval-store/n -> :instruction "承認の規則を実行をまたいで残す保管先を 1 文で書く" :sample "Approval rules persist across sessions via two JSON stores: user-global rules at ˜ /.opendev/permissions.json and project-scoped rules at .opendev/permissions.json.")
(defrule registry-approval-store/a1 -> :instruction "両方があるときの優先を 1 文で書く" :sample "When both exist, project rules take priority for the same pattern, enabling per-repository trust boundaries (e.g., a shared project can restrict docker commands that a user’s personal config allows).")
(defrule registry-approval-store/a2 -> :instruction "承認の聞き方が画面に合わせて変わることを 1 文で書く" :sample "The approval flow adapts to the active frontend: the TUI presents a blocking prompt_toolkit menu with keyboard navigation, while the Web UI broadcasts an approval_required WebSocket event and polls a threading event with a 300-second timeout, rendering an approval dialog in the browser.")
(defrule registry-approval-store/a3 -> :instruction "承認の記録を 1 文で書く" :sample "Every approval decision (command, action taken, matching rule, and timestamp) is recorded in a CommandHistory for audit.")

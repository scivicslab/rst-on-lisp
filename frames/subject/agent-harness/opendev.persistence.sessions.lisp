;;; subject: opendev-terminal-agent-2603 2.5.1 Session Storage: how one conversation is stored as a metadata file and a transcript, written safely, saved automatically, indexed, titled and resumed
;;; made-from: doc_Base012/docs/Papers-AgentHarness/opendev-terminal-agent/05_persistence/05_persistence.lisp / s2 .. s8
;;; members: files safe-write auto-save index titles cost legacy
;;; elsewhere: none
;;; left-out: none
(defrule sessions -> sessions-files sessions-safe-write sessions-auto-save sessions-index sessions-titles sessions-cost sessions-legacy)
(defrule sessions-files -> :nucleus sessions-files/n :elaboration-additional sessions-files/a1 :elaboration-additional sessions-files/a2 :elaboration-additional sessions-files/a3)
(defrule sessions-files/n -> :instruction "会話 1 つを保存するファイルの組を 1 文で書く" :sample "Each conversation is stored as two files: a .json metadata file and a .jsonl transcript file.")
(defrule sessions-files/a1 -> :instruction "メタデータが持つ項目を 1 文で書く" :sample "The metadata file records the session identifier, creation and last-activity timestamps, working directory, title, and summary, but contains no messages.")
(defrule sessions-files/a2 -> :instruction "本文のファイルが持つ内容を 1 文で書く" :sample "The transcript file stores the actual messages, one per line, each serialized as a JSON object with role, content, timestamp, tool calls, and token counts.")
(defrule sessions-files/a3 -> :instruction "分ける利点を 1 文で書く" :sample "Splitting metadata from messages means that listing all sessions (to show the user a session picker) requires reading only the small metadata files rather than loading potentially large transcript histories.")
(defrule sessions-safe-write -> :nucleus sessions-safe-write/n :elaboration-additional sessions-safe-write/a1 :elaboration-additional sessions-safe-write/a2 :elaboration-additional sessions-safe-write/a3)
(defrule sessions-safe-write/n -> :instruction "同時に書かれても失われない書き込みの手順を 1 文で書く" :sample "Sessions are saved through a write flow designed to prevent data loss even under concurrent access.")
(defrule sessions-safe-write/a1 -> :instruction "書く前の排他の取り方を 1 文で書く" :sample "Before writing, the system acquires an exclusive file lock (fcntl.flock) on the metadata file with a 10-second timeout to prevent deadlocks.")
(defrule sessions-safe-write/a2 -> :instruction "一時ファイルへ書いて置き換える手順と、その保証を 1 文で書く" :sample "The metadata is then written to a temporary file and atomically renamed into place using os.rename(), which on POSIX systems guarantees that the file is either fully written or untouched, never half-written.")
(defrule sessions-safe-write/a3 -> :instruction "本文のファイルと索引の扱いを 1 文で書く" :sample "The transcript file follows the same locking protocol.")
(defrule sessions-auto-save -> :nucleus sessions-auto-save/n :elaboration-additional sessions-auto-save/a1 :elaboration-additional sessions-auto-save/a2 :elaboration-additional sessions-auto-save/a3)
(defrule sessions-auto-save/n -> :instruction "明示の保存の指示を要らなくする自動保存の間隔を 1 文で書く" :sample "Rather than requiring explicit save commands, the system auto-saves the conversation every 5 turns (configurable via auto_save_interval).")
(defrule sessions-auto-save/a1 -> :instruction "保存の内容を 1 文で書く" :sample "Each auto-save writes both the metadata and the full transcript.")
(defrule sessions-auto-save/a2 -> :instruction "保存の間のメッセージの在り処を 1 文で書く" :sample "Between auto-saves, messages exist only in memory.")
(defrule sessions-auto-save/a3 -> :instruction "複数の経路の配備での追記の方式を 1 文で書く" :sample "For multi-channel deployments (such as a web interface), a separate append-only path writes each new message individually to the transcript file under an exclusive lock, providing immediate durability at the cost of one file-system call per message.")
(defrule sessions-index -> :nucleus sessions-index/n :elaboration-additional sessions-index/a1 :elaboration-additional sessions-index/a2 :elaboration-additional sessions-index/a3)
(defrule sessions-index/n -> :instruction "一覧を走査すると遅くなる問題を 1 文で書く" :sample "Listing sessions by scanning every metadata file in the project directory is slow when many sessions accumulate.")
(defrule sessions-index/a1 -> :instruction "軽い索引のファイルと、その内容を 1 文で書く" :sample "A lightweight index file (sessions-index.json) caches the essential fields (session ID, title, message count, last-modified timestamp) at roughly 200 bytes per entry, enabling instant session listing.")
(defrule sessions-index/a2 -> :instruction "索引が壊れたときの自動の再構築を 1 文で書く" :sample "If the index file is missing, corrupted, or has a permission error, the system rebuilds it automatically by scanning all metadata files in the directory, creating entries for each valid session and deleting empty ones.")
(defrule sessions-index/a3 -> :instruction "この自己修復の意味を 1 文で書く" :sample "This self-healing behavior means the index never becomes a single point of failure: even if the file is accidentally deleted or corrupted, the next list_sessions call regenerates it transparently.")
(defrule sessions-titles -> :nucleus sessions-titles/n :elaboration-additional sessions-titles/a1 :elaboration-additional sessions-titles/a2 :elaboration-additional sessions-titles/a3)
(defrule sessions-titles/n -> :instruction "新しい会話に題が無いことを 1 文で書く" :sample "When a new session is first saved, it has no meaningful title.")
(defrule sessions-titles/a1 -> :instruction "題を作る仕組みと、止めない工夫を 1 文で書く" :sample "A lightweight topic-detection model generates a short title (capped at 50 characters) by examining the last 4 messages.")
(defrule sessions-titles/a2 -> :instruction "指定が無いときに開く会話を 1 文で書く" :sample "When the user starts the agent in a project directory without specifying a session, the system defaults to the most recent session for that project, enabling a “continue where I left off” workflow.")
(defrule sessions-titles/a3 -> :instruction "入れ子の案件の会話が混ざらない理由を 1 文で書く" :sample "Sessions from nested subprojects do not appear in the parent project’s list because each project root produces a distinct encoded path.")
(defrule sessions-cost -> :nucleus sessions-cost/n :elaboration-additional sessions-cost/a1 :elaboration-additional sessions-cost/a2)
(defrule sessions-cost/n -> :instruction "会話の費用を記録する項目と内容を 1 文で書く" :sample "Each session’s metadata file includes a cost_tracking object that records cumulative API usage: total input tokens, total output tokens, total cost in USD (computed from model pricing metadata), and the number of API calls.")
(defrule sessions-cost/a1 -> :instruction "更新の時機を 1 文で書く" :sample "This metadata is updated after every LLM call and persisted with the session.")
(defrule sessions-cost/a2 -> :instruction "再開時に費用の表示が保たれることを 1 文で書く" :sample "When the user resumes a session via --continue, the CostTracker service restores its state from this metadata, ensuring that the running cost display reflects the full session history rather than only the current invocation.")
(defrule sessions-legacy -> :nucleus sessions-legacy/n :elaboration-additional sessions-legacy/a1)
(defrule sessions-legacy/n -> :instruction "古い版が本文をどこに置いていたかを 1 文で書く" :sample "Earlier versions stored messages inline in the metadata JSON file rather than in a separate JSONL transcript.")
(defrule sessions-legacy/a1 -> :instruction "見つけたときの自動の移行を 1 文で書く" :sample "When the system encounters a session with inline messages and no JSONL file, it automatically migrates the messages to a new JSONL file, clears the inline messages from the metadata, and saves a backup of the original file.")

;;; subject: opendev-terminal-agent-2603 2.2.4 REPL Command Dispatch: how input that needs no model is handled directly by commands, and how commands differ from the tools the model calls
;;; made-from: doc_Base012/docs/Papers-AgentHarness/opendev-terminal-agent/02_agent-core/02_agent-core.lisp / s29 .. s33
;;; members: split handler categories side-effects separation
;;; elsewhere: none
;;; left-out: the caption of Figure 7
(defrule repl-dispatch -> repl-dispatch-split repl-dispatch-handler repl-dispatch-categories repl-dispatch-side-effects repl-dispatch-separation)
(defrule repl-dispatch-split -> :nucleus repl-dispatch-split/n :elaboration-additional repl-dispatch-split/a1 :elaboration-additional repl-dispatch-split/a2)
(defrule repl-dispatch-split/n -> :instruction "前の節の道筋が前提にしていることと、それが成り立たない入力があることを 1 文で書く" :sample "The conversation lifecycle described above assumes that user input enters the agent reasoning loop.")
(defrule repl-dispatch-split/a1 -> :instruction "モデルを通さずに済む操作の例を 1 文で書く" :sample "Session management, mode switching, model selection, and MCP server configuration are deterministic operations that can be handled directly by the REPL without invoking the agent.")
(defrule repl-dispatch-split/a2 -> :instruction "入力の境界での二つの経路を 1 文で書く" :sample "The system therefore implements a dual-path dispatch at the input boundary: if the input begins with a “ / ” prefix, it is routed to a registered command handler; otherwise, it proceeds to the query processor and enters the agent loop.")
(defrule repl-dispatch-handler -> :nucleus repl-dispatch-handler/n :elaboration-additional repl-dispatch-handler/a1 :elaboration-additional repl-dispatch-handler/a2 :elaboration-additional repl-dispatch-handler/a3)
(defrule repl-dispatch-handler/n -> :instruction "命令の取り扱い部品が共通の親を持つことを 1 文で書く" :sample "All command handlers extend a common abstract base class that provides the handler interface and standardized output formatting.")
(defrule repl-dispatch-handler/a1 -> :instruction "部品が管理部品を受け取る方法を 1 文で書く" :sample "Each handler receives a reference to the REPL instance at construction, granting access to the shared managers (session, mode, configuration, MCP) through explicit dependency injection rather than global state.")
(defrule repl-dispatch-handler/a2 -> :instruction "取り扱いの手続きが何を行い何を返すかを 1 文で書く" :sample "The handler’s handle(args) method performs argument parsing, executes the operation, and returns a CommandResult containing a success flag, a human-readable message, and optional structured data.")
(defrule repl-dispatch-handler/a3 -> :instruction "下位命令を持つ命令の扱いを 1 文で書く" :sample "Commands with subcommands (e.g., /mcp connect, /agents create) perform a second-level split on the argument string and dispatch internally to the appropriate method.")
(defrule repl-dispatch-categories -> :nucleus repl-dispatch-categories/n :elaboration-additional repl-dispatch-categories/a1 :elaboration-additional repl-dispatch-categories/a2 :elaboration-additional repl-dispatch-categories/a3 :elaboration-additional repl-dispatch-categories/a4 :elaboration-additional repl-dispatch-categories/a5 :elaboration-additional repl-dispatch-categories/a6)
(defrule repl-dispatch-categories/n -> :instruction "取り扱い部品の種類の数を 1 文で書く" :sample "As shown in Figure 7, nine handler classes cover the system’s interactive control surface.")
(defrule repl-dispatch-categories/a1 -> :instruction "会話の状態の命令を 1 文で書く" :sample "Session commands (/clear, /compact) manage conversation state: clearing saves the current session and starts fresh, while compacting triggers context reduction on demand.")
(defrule repl-dispatch-categories/a2 -> :instruction "モードの命令を 1 文で書く" :sample "Mode commands (/mode) switch between normal and plan mode by setting a pending flag that the query processor reads on the next user query.")
(defrule repl-dispatch-categories/a3 -> :instruction "設定の命令を 1 文で書く" :sample "Configuration commands (/models) present an interactive model selector that, upon selection, triggers a full agent rebuild with the new model configuration.")
(defrule repl-dispatch-categories/a4 -> :instruction "外部の道具のサーバの命令を 1 文で書く" :sample "MCP commands (/mcp) expose eleven subcommands for managing Model Context Protocol servers: connecting, disconnecting, listing tools, and testing server health.")
(defrule repl-dispatch-categories/a5 -> :instruction "エージェント、指示書、拡張の命令を 1 文で書く" :sample "Agent, skills, and plugin commands manage custom agent definitions, reusable prompt templates, and third-party extensions, respectively.")
(defrule repl-dispatch-categories/a6 -> :instruction "初期化と案内の命令を 1 文で書く" :sample "Tool commands (/init) initialize codebase context, and a help command lists all available commands.")
(defrule repl-dispatch-side-effects -> :nucleus repl-dispatch-side-effects/n :elaboration-additional repl-dispatch-side-effects/a1 :example repl-dispatch-side-effects/a2 :elaboration-additional repl-dispatch-side-effects/a3)
(defrule repl-dispatch-side-effects/n -> :instruction "命令が共有の状態を変更することを 1 文で書く" :sample "Commands do not produce isolated outputs; they modify shared state that subsequent agent interactions depend on.")
(defrule repl-dispatch-side-effects/a1 -> :instruction "命令とエージェントのループが同じ状態に集まることを 1 文で書く" :sample "As depicted in the right column of Figure 7, both command handlers and the agent loop converge on the same system state.")
(defrule repl-dispatch-side-effects/a2 -> :instruction "命令の副作用の具体例を、命令ごとに挙げて 1 文で書く" :sample "For example, /models triggers a full reconstruction of the agent factory, rebuilding tool registries and system prompts with the new model’s capabilities. /mcp connect discovers and registers new tools from the connected server, expanding the tool schemas available to the agent on its next turn. /mode plan sets a flag that causes the query processor to activate planning behavior on the next query.")
(defrule repl-dispatch-side-effects/a3 -> :instruction "副作用が果たす役割を 1 文で書く" :sample "These side effects are the primary mechanism through which commands influence agent behavior without directly entering the reasoning loop.")
(defrule repl-dispatch-separation -> :nucleus repl-dispatch-separation/n :elaboration-additional repl-dispatch-separation/a1 :comparison repl-dispatch-separation/a2 :elaboration-additional repl-dispatch-separation/a3 :result repl-dispatch-separation/a4)
(defrule repl-dispatch-separation/n -> :instruction "命令とエージェントの道具の区別が構造上のものであることを 1 文で書く" :sample "The distinction between REPL commands and agent tools is architectural, not incidental.")
(defrule repl-dispatch-separation/a1 -> :instruction "命令の性質を 1 文で書く" :sample "Commands are triggered by the user typing a slash prefix, executed synchronously by the REPL, and require no LLM involvement, no tool-use hooks, no approval gates, and no undo tracking.")
(defrule repl-dispatch-separation/a2 -> :instruction "道具の性質を対比して 1 文で書く" :sample "Agent tools, by contrast, are selected by the LLM during reasoning, executed through the tool registry with pre- and post-execution hooks, subject to user approval based on the configured autonomy level, and tracked by the undo manager.")
(defrule repl-dispatch-separation/a3 -> :instruction "動作する場所の違いを 1 文で書く" :sample "Commands operate on the REPL instance; tools operate within a run context that carries agent dependencies.")
(defrule repl-dispatch-separation/a4 -> :instruction "この分離で得られることを 1 文で書く" :sample "This separation ensures that system-level operations (changing models, managing servers, resetting sessions) remain fast and predictable, while delegating open-ended problem-solving to the agent loop.")

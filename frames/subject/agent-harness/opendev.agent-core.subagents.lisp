(defrule subagents-restrict -> :nucleus subagents-restrict/n :elaboration-process-step subagents-restrict/a1 :elaboration-process-step subagents-restrict/a2 :elaboration-process-step subagents-restrict/a3)
(defrule subagents-restrict/n -> :instruction "部下の能力を意図的に制限する理由の数を 1 文で書く" :sample "Subagent capabilities are deliberately restricted for three reasons.")
(defrule subagents-restrict/a1 -> :instruction "第 1 の理由を 1 文で書く" :sample "First, task management tools are excluded from subagents so that only the main agent coordinates todo lists, preventing race conditions and inconsistent state.")
(defrule subagents-restrict/a2 -> :instruction "第 2 の理由を 1 文で書く" :sample "Second, limited tool access reduces context size and focuses each subagent on its specific role, meaning an exploration subagent does not need write capabilities.")
(defrule subagents-restrict/a3 -> :instruction "第 3 の理由を 1 文で書く" :sample "Third, restricted tools limit the blast radius of errors: an exploration subagent cannot accidentally modify files.")
(defrule subagents-parallel -> :nucleus subagents-parallel/n :elaboration-additional subagents-parallel/a1 :elaboration-additional subagents-parallel/a2 :elaboration-additional subagents-parallel/a3 :elaboration-additional subagents-parallel/a4)
(defrule subagents-parallel/n -> :instruction "部下を並べて動かせる場面を 1 文で書く" :sample "The main agent can spawn multiple subagents concurrently (each in its own thread) for independent queries such as parallel file searches, codebase exploration, or web fetches.")
(defrule subagents-parallel/a1 -> :instruction "いつ並べるかについての指示を 1 文で書く" :sample "The system prompt explicitly guides the agent on when and how to parallelize: when the user requests multiple independent analyses, when exploring a large codebase, or when tasks have no data dependencies.")
(defrule subagents-parallel/a2 -> :instruction "並べるための呼び出し方を 1 文で書く" :sample "Making multiple spawn_subagent calls in the same response triggers automatic parallel execution.")
(defrule subagents-parallel/a3 -> :instruction "結果のまとめ方を 1 文で書く" :sample "Upon completion, the agent is instructed to synthesize all subagent results into a single unified response organized by topic, rather than summarizing each agent separately.")
(defrule subagents-parallel/a4 -> :instruction "この方式が引き換えにするものを 1 文で書く" :sample "This trades thread overhead for latency reduction on independent operations.")
(defrule subagents-stop-conditions -> :nucleus subagents-stop-conditions/n :elaboration-additional subagents-stop-conditions/a1 :elaboration-additional subagents-stop-conditions/a2 :elaboration-additional subagents-stop-conditions/a3)
(defrule subagents-stop-conditions/n -> :instruction "部下の指示に終了の条件を入れる理由を 1 文で書く" :sample "Subagent prompts include explicit termination conditions to prevent over-exploration.")
(defrule subagents-stop-conditions/a1 -> :instruction "探索役の止め方の指示を 1 文で書く" :sample "The Code Explorer subagent has stop conditions (“ stop when evidence is clear,” “ stop if progress stalls,” “ prefer depth over breadth ”) and an anti-loop instruction (“ re-reading the same file triggers immediate stop ”).")
(defrule subagents-stop-conditions/a2 -> :instruction "計画役への指示を 1 文で書く" :sample "The Planner subagent is instructed to include the plan_file_path in its completion summary so the main agent can immediately pass it to present_plan.")
(defrule subagents-stop-conditions/a3 -> :instruction "考える段階の指示が探索役をどう使うかを 1 文で書く" :sample "The thinking-mode prompts encourage spawning Code Explorer subagents for tasks requiring deep codebase analysis.")
(defrule subagents-design-evolution -> :nucleus subagents-design-evolution/n :elaboration-additional subagents-design-evolution/a1 :elaboration-additional subagents-design-evolution/a2)
(defrule subagents-design-evolution/n -> :instruction "初期の版で部下に何を持たせていたかと、その問題を 1 文で書く" :sample "Early versions gave subagents the same tools as the main agent.")
(defrule subagents-design-evolution/a1 -> :instruction "制限した効果を 1 文で書く" :sample "Restricting each subagent’s tool set to its specific role improved both focus and efficiency.")
(defrule subagents-design-evolution/a2 -> :instruction "終了条件が無かった失敗と、その解決を 1 文で書く" :sample "Early subagent prompts lacked clear stop conditions, leading to unbounded exploration where the Code Explorer would read the same files repeatedly; adding explicit stop conditions and anti-loop instructions resolved this.")

(defrule model-facts-part -> :nucleus model-facts :rank secondary)
(defrule session-decisions -> :instruction "保存で下した設計の決定を、1 行に 1 つ決定の名前で挙げる。ファイルの分け方、書き込みの安全、保存の間隔、索引、取り消しの仕組みのうち、このハーネスにあるもの" :frame "explain-agent-harness.decision.lisp")
(defrule session-part -> :nucleus session-identity :elaboration-process-step session-resume :elaboration-additional session-fork :elaboration-additional transcript-store :elaboration-part-whole undo-part :elaboration-additional session-decisions :elaboration-additional configuration-part :elaboration-additional model-facts-part)

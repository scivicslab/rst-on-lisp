;;; how: the members are the union of the members of the integrated frames, not their intersection. Members with the same
;;;      meaning are one member here; a member only one frame has is kept. A harness fills the members that apply to it and
;;;      leaves the others empty. Instructions speak of "the harness" in general; each :sample is the fullest verbatim
;;;      instance from the sources.
;;; roles (role: claude-doc / opendev; - = the source has no such member)
;;;   orientation:        agent-loop p-intro                        / opendev p-overview-roadmap
;;;   what:               agent-loop p-cycle                        / agent-core perspectives (harness defined and set against scaffolding)
;;;   request-path:       agent-loop glance-steps                   / lifecycle (entry-paths, iteration, termination)
;;;   entry-paths:        -                                         / lifecycle entry-paths
;;;   executor-and-setup: -                                         / react-loop loop-executor loop-query-setup
;;;   phases:             -                                         / react-loop phases (one copy of the phase sub-frame each)
;;;   thinking-split:     -                                         / react-loop loop-purpose
;;;   tool-branch:        -                                         / react-loop loop-branch
;;;   stuck-loop:         -                                         / react-loop loop-repeat-handling
;;;   run-ends:           agent-loop result (subtypes)              / react-loop loop-ending-paths loop-premature-end-guard
;;;   limits-part:        agent-loop limits                         / react-loop loop-ending-paths (the iteration cap)
;;;   concrete-turns:     agent-loop turns-example                  / -
;;;   messages-part:      agent-loop message-kinds                  / -
;;;   result-part:        agent-loop result                         / -
;;;   models-part:        agent-loop control (p-model), effort      / multi-model (roles, decisions), react-loop phase controls (depth levels)
;;;   structure-part:     -                                         / opendev (layers), agent-core, scaffolding, runtime (decisions)
;;;   tools-part:         agent-loop tool-execution (parallel)      / tool-system (all), tool-result, retrieval
;;;   deferred-schemas:   agent-loop context-window efficiency, context-source (MCP, tool definitions) / external-tools
;;;   skills-part:        agent-loop context-source (skill descriptions) / delegation (skills), tool-system.skill-phase
;;;   context-part:       agent-loop context-window                 / context-engineering (all)
;;;   window:             agent-loop context-window p-context-what, p-consumes-note / context-engineering p-context-layer-defined
;;;   context-sources:    agent-loop sources                        / prompt-construction (tiers), retrieval (assembly)
;;;   compaction-part:    agent-loop compaction                     / compaction (stages, artifact index), react-loop phase (context management)
;;;   context-saving:     agent-loop efficiency                     / tool-result, dual-memory, retrieval (explorer)
;;;   control-part:       agent-loop permission-mode, tool-execution (permissions), hooks / registry (approval), lifecycle (hooks, mechanisms), repl-dispatch, runtime (planning)
;;;   approval-part:      agent-loop permission-mode                / registry p-approval-gate (autonomy levels)
;;;   call-policies-part: agent-loop tool-execution permissions     / registry p-approval-gate, p-approval-persistence
;;;   hooks-part:         agent-loop hooks                          / lifecycle p-lifecycle-hooks, registry p-tool-lifecycle-hooks
;;;   plan-then-act:      agent-loop permission-mode ("plan")       / runtime (planner-stages, plan-review, replanning)
;;;   slash-commands:     -                                         / repl-dispatch
;;;   mechanisms:         -                                         / lifecycle (interrupt, injection queue, cost)
;;;   usage-part:         agent-loop result (usage, cost)           / lifecycle p-cost-tracking
;;;   delegation-part:    agent-loop context-window (subagents)     / subagents
;;;   session-part:       agent-loop session                        / sessions, operation-log, configuration, model-cache
;;;   configuration-part: -                                         / configuration
;;;   model-facts-part:   -                                         / model-cache
;;;   history-part:       -                                         / design-change items of every OpenDev node
;;;   decisions (model-decisions structure-decisions tool-decisions context-decisions control-decisions delegation-decisions session-decisions): - / the paragraphs listed under `moved into design-decision items` in the OpenDev frames
(in-package :rst)
(defdocument ExplainAgentHarnessFrame)

(defrule document -> title sections)
(defrule title -> :instruction "説明するエージェントのハーネスの名前を題にする。設計だけ、ある部分だけを説明するなら、その語を添える")
(defrule sections -> s1)
;; The nucleus is what the harness is and what its loop does for one request (what). Every other part says, by its relation,
;; what it does for the nucleus. A part marked :rank secondary is far from the nucleus by its relation: it describes a side
;; fact or retells (see the table below).
;;   steps from the nucleus  part
;;   0                       what
;;   1                       orientation (background); loop-part (process step); models-part (attribute); structure-part, tools-part,
;;                           context-part, control-part, delegation-part, session-part (parts of the harness); history-part (evaluation)
;;   2                       inside loop-part: request-path, phases, thinking-split, tool-branch, stuck-loop, run-ends, limits-part,
;;                           messages-part, result-part; inside each part: its blanks and sub-paragraphs
;;   secondary               messages-part and result-part (how the loop reports to its caller: side facts of run-ends), usage-part and
;;                           configuration-part and model-facts-part (side facts of control and session), history-part (retells why the
;;                           design is as it is). Each is far from the nucleus by its relation and its steps; none is judged by how many
;;                           sources mention it.
(defrule s1 -> harness :heading "## Agent harness")
(defrule orientation -> :instruction "この説明が扱うハーネスの仕組みの範囲を 1 文で書く" :sample "Understand the message lifecycle, tool execution, context window, and architecture that power your SDK agents.")
(defrule what -> :nucleus what-definition :elaboration-process-step what-request :comparison what-scaffolding)
(defrule what-definition -> :instruction "ハーネスとは何かを、モデルを何が包み、何を調整するかで 1 文で定義する" :sample "In this context, a harness is the runtime orchestration layer that wraps the core reasoning loop and coordinates tool execution, context management, safety enforcement, and session persistence around it [99].")
(defrule what-request -> :instruction "1 件の依頼に対して、ハーネスのループが何を繰り返し、いつ終わるかを 1 文で書く" :sample "Claude continues calling tools and processing results until it produces a response with no tool calls.")
(defrule what-scaffolding -> :instruction "ハーネスが関わるのは、エージェントを組み立てた後の何かを、組み立ての関心と対比して 1 文で書く。対比が無ければ空にする" :sample "Where scaffolding is concerned with constructing the agent before the first prompt, the harness is concerned with everything that happens after: dispatching tools, compacting context, enforcing safety invariants, and persisting state across turns.")
(defrule request-path -> :instruction "1 件の依頼が通る段階を、起きる順に 1 項目ずつ、段階の名前に続けて、誰が何を受け取り何を返すかで書く" :sample "Receive prompt. Claude receives your prompt, along with the system prompt, tool definitions, and conversation history. / Execute tools. The SDK runs each requested tool and collects the results. / Repeat. Steps 2 and 3 repeat as a cycle. Each full cycle is one turn. / Return result. The SDK yields a final AssistantMessage with the text response (no tool calls), followed by a ResultMessage with the final text, token usage, cost, and session ID." :kind bullet)
(defrule entry-paths -> :instruction "依頼が入る経路の数と種類を 1 文で書く。経路ごとの前処理の違いがあれば、それも書く" :sample "User input arrives through one of three entry paths: a non-interactive CLI invocation that creates a one-shot session, the TUI that wraps an interactive REPL, or the Web UI that accepts messages over WebSocket.")
(defrule executor -> :instruction "1 件の依頼を処理する部品の名前と、それが実装するループの種類を 1 文で書く" :sample "Once a mode is selected, the agent processes each user query through the ReactExecutor, which implements an extended version of the Reason-Act loop [96] (referred to simply as the ReAct loop throughout this paper).")
(defrule query-setup -> :instruction "依頼が来たときに、繰り返しの前に整える状態と部品を 1〜2 文で書く。繰り返しをまたいで持つ状態の入れ物があれば、その中身も書く" :sample "When a query arrives, the executor clears any pending injection queue, creates an interrupt token for cancellation support, wraps the conversation history in a ValidatedMessageList (which enforces correct message alternation), and bundles everything into an IterationContext. This context object carries all per-query state: iteration counters, one-shot guard flags (to prevent duplicate signals), and references to shared services such as the tool registry and approval manager.")
(defrule executor-and-setup -> :nucleus executor :elaboration-process-step query-setup)
(defrule phases -> :instruction "ループの 1 回の繰り返しを構成する段階を、行う順に、1 行に 1 つ段階の名前で挙げる。文脈の管理、考える段階、行動の段階、道具の実行のうち、このハーネスにある段階だけを挙げる" :frame "explain-agent-harness.phase.lisp")
(defrule thinking-plain-limit -> :instruction "素朴な推論と行動の繰り返しが、考える深さを制限する理由を、その原因とともに 1〜2 文で書く。ハーネスが素朴な方式を採るなら、避けられない制限を書く" :sample "Standard ReAct [96] interleaves reasoning and action in the same turn, which limits deliberation. Tool schemas consume context and create pressure to act quickly rather than think deeply.")
(defrule thinking-design-choice -> :instruction "このハーネスのループが、考える段階と行動の段階をどう組み合わせるかを 1 文で書く" :sample "OpenDev combines the latter two: an explicit thinking phase before action, with optional self-critique for complex tasks.")
(defrule thinking-split -> :background thinking-plain-limit :nucleus thinking-design-choice)
(defrule tool-branch -> :instruction "行動の段階の結果が、道具の呼び出しを含むかどうかで処理が分かれることを書く。含まないときの扱いが、失敗の後始末、未完の仕事への催促、終了などに分かれるなら、それも書く" :sample "The executor branches based on whether the action model produced tool calls. If no tool calls are present: when the previous tool failed, the executor classifies the error (permission denied, file not found, syntax error, rate limit, etc.) and injects a targeted recovery nudge (Section 2.3.5); when there are incomplete todos, it nudges the agent to continue; otherwise, a text-only response with no error signals task completion, and the loop terminates.")
(defrule stuck-detection -> :instruction "同じ道具の呼び出しの繰り返しを、何を比べ、どの範囲を見て見つけるかを書く。繰り返しを見つける仕組みが無いハーネスでは、段落ごと書かない" :sample "If tool calls are present, the executor first performs doom-loop detection with a two-tier escalation: each tool call is fingerprinted as an MD5 hash of the tool name and its arguments, and fingerprints are tracked in a sliding window of the 20 most recent calls.")
(defrule stuck-first-response -> :instruction "繰り返しを見つけた最初の対処を書く。モデルに何を伝え、その回の道具の実行をどうするか" :sample "If any fingerprint appears 3 or more times, the system injects a [SYSTEM WARNING] message into the conversation (e.g., “ the agent has called read_file with the same arguments 3 times; try a different approach ”) and skips tool execution for that turn.")
(defrule stuck-escalation -> :instruction "最初の対処の後にも繰り返すときの次の対処を書く。人に判断を求めるなら、人の選択肢ごとの動作も書く" :sample "If the same fingerprint recurs after the warning, the system escalates to an approval-based pause via the ApprovalManager, presenting the user with “ Agent is repeating the same action.")
(defrule stuck-assessment -> :instruction "段階を踏む対処が、警告だけの対処より頑丈な理由を書く。従来の粗い歯止めが見逃すものがあれば、それも書く" :sample "This two-tier approach is more robust than warnings alone: LLMs can ignore injected text, but they cannot bypass a genuine execution halt.")
(defrule stuck-loop -> :nucleus stuck-detection :elaboration-process-step stuck-first-response :elaboration-process-step stuck-escalation :evaluation-s stuck-assessment)
(defrule ending-paths -> :instruction "ループが終わる経路を、種類ごとに書く。明示の完了の合図、道具を呼ばない応答、回復の試行の尽き、繰り返しの回数や費用の上限のうち、このハーネスにあるもの" :sample "The loop ends through one of four paths: the agent explicitly calls a completion tool with a summary and status (success or failure); the agent produces a text response with no tool calls and no error condition (implicit completion); the error-recovery nudge budget is exhausted (three consecutive failed attempts); or the iteration count reaches a configurable safety limit.")
(defrule endings -> :instruction "終わり方を、1 行に 1 つ終わり方の名前で挙げる。呼び出し元に終わり方が名前で伝わるハーネスなら、その名前で挙げる" :frame "explain-agent-harness.ending.lisp")
(defrule premature-end-guard -> :instruction "終わりを受け入れる前に確かめることと、終わるときに保存するものを書く。未完の仕事が残る場合の扱いがあれば、それを書く" :sample "If outstanding task items remain when the agent signals completion, the system injects additional nudges to address them before accepting termination to prevent premature completion with incomplete work. In all cases, the final conversation state is persisted to the session store.")
(defrule run-ends -> :nucleus ending-paths :elaboration-set-member endings :elaboration-additional premature-end-guard)
(defrule limit-settings -> :instruction "実行の長さや費用に上限を置く設定を、1 行に 1 つ、設定の名前、上限にするもの、既定の値の順に、' | ' で区切って書く。見出しの行を先頭に置く" :sample "Option | What it controls | Default / Max turns (max_turns / maxTurns) | Maximum tool-use round trips | No limit" :kind table)
(defrule limit-at-cap -> :instruction "上限に達したときにハーネスが返すものと、上限が部下の実行にも及ぶかを 1〜2 文で書く" :sample "When either limit is hit, the SDK returns a ResultMessage with a corresponding error subtype (error_max_turns or error_max_budget_usd). The budget cap covers subagents: their spend counts toward the total.")
(defrule limit-overshoot -> :instruction "上限をいつ照らし合わせるかと、その結果、費用が上限を超えうる幅を書く。超えないなら書かない" :sample "Spend can therefore pass the cap by up to the cost of that one response, plus anything that subagents still running at that moment spend before they stop.")
(defrule limits-part -> :nucleus limit-settings :elaboration-process-step limit-at-cap :elaboration-additional limit-overshoot)
(defrule concrete-turns -> :instruction "実際の 1 回の実行を、ターンごとに 1 項目ずつ、そのターンで呼んだ道具と受け取った結果で書く。最後は道具を呼ばない文章だけの応答で終える" :sample "Turn 1: Claude calls Bash to run npm test. The SDK yields an AssistantMessage with the tool call, executes the command, then yields a UserMessage with the output (three failures). / Final turn: Claude produces a text-only response with no tool calls: \"Fixed the auth bug, all three tests pass now.\"" :kind bullet)
(defrule message-kinds -> :instruction "ループが呼び出し元へ出す知らせの種類を、1 行に 1 つ種類の名前で挙げる。知らせを種類で出さないハーネスなら、書かない" :frame "explain-agent-harness.message-kind.lisp")
(defrule message-handling -> :instruction "呼び出し元が知りたいことごとに、どの知らせを見ればよいかを、1 項目ずつ書く" :sample "Final results only: handle ResultMessage to get the output, cost, and whether the task succeeded or hit a limit. / Progress updates: handle AssistantMessage to see what Claude is doing each turn, including which tools it called. / Live streaming: enable partial messages (include_partial_messages in Python, includePartialMessages in TypeScript) to get StreamEvent messages in real time." :kind bullet)
(defrule messages-part -> :nucleus message-kinds :elaboration-process-step message-handling :rank secondary)
(defrule result-what -> :instruction "終了の知らせが何を伝え、終わり方をどの欄で見分けるかを 1〜2 文で書く" :sample "When the loop ends, the ResultMessage tells you what happened and gives you the output. The subtype field (available in both SDKs) is the primary way to check termination state.")
(defrule result-field -> :instruction "最終の文章がどの終わり方にだけ付くか、どの終わり方にも付く欄は何かを 1〜2 文で書く" :sample "The result field holds the final text output and is only present on the success variant, so always check the subtype before reading it. All result subtypes carry total_cost_usd, usage, num_turns, and session_id so you can track cost and resume even after errors.")
(defrule result-pitfalls -> :instruction "結果を読むときの落とし穴を、1 つにつき 1 項目で、どんな場合に何が起きるかと、どう確かめるかで書く" :sample "After a session crash, the final result is an error_during_execution whose cost fields may be zeroed and whose stop_reason is null, and the process exits after emitting it. / The usage field covers only the main agent loop. Use modelUsage, or model_usage in Python, for whole-tree token and cost accounting." :kind bullet)
(defrule stop-reason -> :instruction "最後にモデルが生成をやめた理由を示す欄と、よくある値を書く。無ければ書かない" :sample "Common values are end_turn (model finished normally), max_tokens (hit the output token limit), and refusal (the model declined the request).")
(defrule result-part -> :nucleus result-what :elaboration-object-attribute result-field :elaboration-additional result-pitfalls :elaboration-additional stop-reason :rank secondary)
(defrule loop-part -> :nucleus request-path :elaboration-additional entry-paths :background executor-and-setup :elaboration-set-member phases :elaboration-object-attribute thinking-split :elaboration-process-step tool-branch :elaboration-additional stuck-loop :elaboration-process-step run-ends :elaboration-object-attribute limits-part :example concrete-turns :elaboration-object-attribute messages-part :elaboration-object-attribute result-part)
(defrule model-choice -> :instruction "どのモデルで実行するかを選ぶ設定を 1 文で書く。役割ごとに別のモデルを使うなら、その旨も書く" :sample "Set the model option to choose which model runs the session.")
(defrule model-roles -> :instruction "モデルの役割を、1 行に 1 つ役割の名前で挙げる。役割を分けないハーネスなら、書かない" :frame "explain-agent-harness.model-role.lisp")
(defrule depth-what -> :instruction "モデルがどれだけ考えるかを決める設定が何を制御するかを 1 文で書く" :sample "The effort option controls how much reasoning Claude applies.")
(defrule depth-levels -> :instruction "水準を、浅い方から順に、1 行に 1 つ水準の名前で挙げる" :frame "explain-agent-harness.effort-level.lisp")
(defrule depth-tradeoff -> :instruction "その設定が何と何を引き換えにするかを 1〜2 文で書く" :sample "effort trades latency and token cost for reasoning depth within each response. Extended thinking is a separate mechanism.")
(defrule depth-part -> :nucleus depth-what :elaboration-set-member depth-levels :elaboration-additional depth-tradeoff)
